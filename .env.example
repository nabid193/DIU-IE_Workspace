# Local development settings
PORT=3000
APP_BASE_URL=http://localhost:3000

# Paste your NEW Neon pooled PostgreSQL connection string here.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Optional for local testing. If omitted in development, the reset link is
# printed only in the server Terminal. Required for production email delivery.
RESEND_API_KEY=
MAIL_FROM="DIU I&E Workspace <no-reply@your-verified-domain.com>"
