# This is an example made by AI to look good and .env file for local development. Copy this file to .env and fill in the required values.
# Local development settings
PORT=3000
APP_BASE_URL=http://localhost:3000

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require

# Generate using: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Optional during development; required for production email delivery
RESEND_API_KEY=

# Replace with your verified sender address when configuring email
MAIL_FROM="DIU I&E Workspace <no-reply@your-verified-domain.com>"
